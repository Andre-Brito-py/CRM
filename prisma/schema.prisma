generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model CustomerPayment {
  id               String           @id @default(cuid())
  paymentId        String           @unique
  customerId       String           @unique
  email            String?          @unique
  subscriptionType SubscriptionType @default(FREE)
  createdAt        DateTime?        @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime?        @updatedAt
  customer         User             @relation(fields: [customerId], references: [id])

  @@map("customerPayments")
}

enum PaymentProviderName {
  asaas
  stripe
  pagarme
  mercadopago
}

enum PaymentProviderStatus {
  active
  disabled
}

enum PaymentProviderEnvironment {
  sandbox
  production
}

model PaymentProvider {
  id          String                @id @default(uuid())
  name        PaymentProviderName   @unique
  displayName String
  status      PaymentProviderStatus @default(active)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  credentials PaymentProviderCredential[]
  workspaceSettings WorkspacePaymentSetting[]
  payments    Payment[]
  subscriptions PlatformSubscription[]

  @@map("payment_providers")
}

model PaymentProviderCredential {
  id            String                     @id @default(uuid())
  providerId    String
  environment   PaymentProviderEnvironment
  apiKey        String
  apiSecret     String?
  webhookSecret String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  provider      PaymentProvider            @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, environment])
  @@map("payment_provider_credentials")
}

model WorkspacePaymentSetting {
  id                   String   @id @default(uuid())
  workspaceId           String   @unique
  providerId            String
  providerAccountId     String?
  platformFeePercentage Decimal? @db.Decimal(5, 2)
  platformFeeFixed      Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider  PaymentProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("workspace_payment_settings")
}

model PlatformSubscription {
  id                     String   @id @default(uuid())
  workspaceId             String   @unique
  planId                  String
  providerId              String
  providerSubscriptionId  String?
  status                  String   @default("ACTIVE")
  nextBillingDate         DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
  provider  PaymentProvider @relation(fields: [providerId], references: [id])

  @@index([planId])
  @@index([providerId])
  @@map("platform_subscriptions")
}

model Domain {
  id          String    @id @default(cuid())
  workspaceId String
  addedById   String
  name        String
  createdAt   DateTime? @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime? @updatedAt
  subdomain   String?
  value       String?
  verified    Boolean?  @default(true)
  addedBy     User      @relation(fields: [addedById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("domains")
}

model Member {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  inviter     String
  invitedAt   DateTime?        @default(now())
  joinedAt    DateTime?
  deletedAt   DateTime?
  updatedAt   DateTime?        @updatedAt
  status      InvitationStatus @default(PENDING)
  teamRole    TeamRole         @default(MEMBER)
  member      User             @relation("membership", fields: [email], references: [email])
  invitedBy   User             @relation("inviter", fields: [inviter], references: [email])
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, email])
  @@index([workspaceId, status, deletedAt])
  @@map("members")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String           @id @default(cuid())
  userCode         String           @unique @default(cuid())
  name             String?
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime?        @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime?        @updatedAt
  role             UserRole         @default(USER)
  suspended        Boolean          @default(false)
  password         String?
  twoFactorEnabled Boolean          @default(false)
  twoFactorSecret  String?
  onboardingStatus Json?            @default("{}")
  accounts         Account[]
  activities       Activity[]
  customerPayment  CustomerPayment?
  domains          Domain[]
  membership       Member[]         @relation("membership")
  invitedMembers   Member[]         @relation("inviter")
  sessions         Session[]
  assignedConversations Conversation[] @relation("conversationAssignee")
  assignedDeals   Deal[]         @relation("dealAssignee")
  assignedTasks    Task[]
  createdWorkspace Workspace[]

  @@unique([userCode, email])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationTokens")
}

model Workspace {
  id                     String         @id @default(cuid())
  workspaceCode          String         @unique @default(cuid())
  inviteCode             String         @unique @default(cuid())
  creatorId              String
  name                   String
  slug                   String
  createdAt              DateTime?      @default(now())
  deletedAt              DateTime?
  updatedAt              DateTime?      @updatedAt
  customFieldDefinitions Json?
  activities             Activity[]
  apiKeys                ApiKey[]
  automationRules        AutomationRule[]
  automationJobs         AutomationJob[]
  companies              Company[]
  contacts               Contact[]
  conversations          Conversation[]
  deals                  Deal[]
  domains                Domain[]
  integrations           Integration[]
  messageTemplates       MessageTemplate[]
  members                Member[]
  npsSurveys             NpsSurvey[]
  npsResponses           NpsResponse[]
  payments               Payment[]
  paymentSetting         WorkspacePaymentSetting?
  pipelines              Pipeline[]
  platformSubscription   PlatformSubscription?
  tags                   Tag[]
  tasks                  Task[]
  webhooks               Webhook[]
  creator                User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([workspaceCode, inviteCode])
  @@map("workspaces")
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  name        String    @default("WhatsApp")
  enabled     Boolean   @default(true)
  credentials Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, enabled])
  @@map("integrations")
}

model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  companyId     String?
  name          String
  email         String?
  phone         String?
  asaasCustomerId String?
  jobTitle      String?
  customFields  Json?
  createdAt     DateTime?      @default(now())
  updatedAt     DateTime?      @updatedAt
  deletedAt     DateTime?
  activities    Activity[]
  company       Company?       @relation(fields: [companyId], references: [id])
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  conversations Conversation[]
  deals         Deal[]
  npsResponses  NpsResponse[]
  payments      Payment[]
  tags          Tag[]
  tasks         Task[]

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("contacts")
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    Contact[]

  @@index([workspaceId])
  @@map("tags")
}

model Company {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  website     String?
  industry    String?
  customFields Json?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contacts    Contact[]
  deals       Deal[]

  @@index([workspaceId])
  @@map("companies")
}

model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  stages      Stage[]

  @@index([workspaceId])
  @@map("pipelines")
}

model Stage {
  id         String    @id @default(cuid())
  pipelineId String
  name       String
  order      Int
  color      String?
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  deletedAt  DateTime?
  deals      Deal[]
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id])

  @@index([pipelineId])
  @@map("stages")
}

model Deal {
  id          String     @id @default(cuid())
  workspaceId String
  contactId   String?
  companyId   String?
  stageId     String
  name        String
  amount      Decimal?   @db.Decimal(10, 2)
  closeDate   DateTime?
  customFields Json?
  priority    String?    @default("MEDIUM")
  assigneeId  String?
  createdAt   DateTime?  @default(now())
  updatedAt   DateTime?  @updatedAt
  deletedAt   DateTime?
  activities  Activity[]
  payments    Payment[]
  assignee    User?      @relation("dealAssignee", fields: [assigneeId], references: [id])
  company     Company?   @relation(fields: [companyId], references: [id])
  contact     Contact?   @relation(fields: [contactId], references: [id])
  stage       Stage      @relation(fields: [stageId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  tasks       Task[]

  @@index([workspaceId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, createdAt])
  @@index([stageId])
  @@index([stageId, deletedAt, createdAt])
  @@map("deals")
}

model Payment {
  id                String    @id @default(cuid())
  workspaceId       String
  contactId         String?
  dealId            String?
  providerId        String?
  providerPaymentId String?
  asaasCustomerId   String?
  asaasPaymentId    String?   @unique
  amount            Decimal?  @db.Decimal(10, 2)
  value             Decimal   @db.Decimal(10, 2)
  platformFee       Decimal?  @db.Decimal(10, 2)
  netAmount         Decimal?  @db.Decimal(10, 2)
  description       String?
  status            String    @default("PENDING")
  billingType       String?
  dueDate           DateTime?
  invoiceUrl        String?
  paymentUrl        String?
  paymentLink       String?
  externalReference String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  contact           Contact?  @relation(fields: [contactId], references: [id])
  deal              Deal?     @relation(fields: [dealId], references: [id])
  provider          PaymentProvider? @relation(fields: [providerId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([providerId])
  @@index([providerId, providerPaymentId])
  @@map("payments")
}

enum NpsSurveyTriggerType {
  manual
  deal_closed
  scheduled
}

enum NpsClassification {
  promoter
  passive
  detractor
}

model NpsSurvey {
  id          String               @id @default(uuid())
  workspaceId String
  name        String
  triggerType NpsSurveyTriggerType @default(manual)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses   NpsResponse[]

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("nps_surveys")
}

model NpsResponse {
  id             String           @id @default(uuid())
  workspaceId    String
  surveyId       String
  contactId      String
  score          Int
  feedbackText   String?          @db.Text
  classification NpsClassification
  createdAt      DateTime         @default(now())

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey         NpsSurvey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, surveyId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, classification])
  @@index([workspaceId, createdAt])
  @@unique([surveyId, contactId])
  @@map("nps_responses")
}

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String?
  assigneeId  String?
  platform    String    @default("WHATSAPP")
  externalId  String?
  status      ConversationStatus @default(OPEN)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  assignee    User?     @relation("conversationAssignee", fields: [assigneeId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  messages    Message[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, platform, deletedAt])
  @@map("conversations")
}

model AutomationRule {
  id           String    @id @default(cuid())
  workspaceId   String
  name         String
  triggerType  String
  triggerConfig Json?
  actionType   String
  actionConfig Json?
  isActive     Boolean   @default(true)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
  deletedAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive, deletedAt])
  @@map("automation_rules")
}

model AutomationJob {
  id         String    @id @default(cuid())
  workspaceId String
  ruleId     String?
  status     String    @default("PENDING")
  runAt      DateTime
  attempts   Int       @default(0)
  lastError  String?
  actionType String
  actionConfig Json?
  eventData  Json?
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, runAt])
  @@map("automation_jobs")
}

model MessageTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  content     String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("message_templates")
}

model Webhook {
  id          String    @id @default(cuid())
  workspaceId String
  url         String
  events      Json
  secret      String
  isActive    Boolean   @default(true)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([workspaceId, isActive, deletedAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      Json?
  responseCode Int?
  responseBody String?
  status       String   @default("PENDING") // PENDING, SUCCESS, FAILED
  attempts     Int      @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([status, nextRetryAt, attempts])
  @@map("webhook_deliveries")
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  key         String    @unique
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  direction      String
  type           String
  content        String?
  mediaUrl       String?
  status         String       @default("SENT")
  externalId     String?
  createdAt      DateTime?    @default(now())
  updatedAt      DateTime?    @updatedAt
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, direction, createdAt])
  @@map("messages")
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String?
  dealId      String?
  userId      String?
  type        String    @default("SYSTEM")
  title       String
  content     String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contact     Contact?  @relation(fields: [contactId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  content     String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  priority    String?
  assigneeId  String?
  contactId   String?
  dealId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, isCompleted, dueDate])
  @@index([workspaceId, deletedAt, createdAt])
  @@map("tasks")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  price         Float
  currency      String   @default("USD")
  interval      String   @default("month")
  stripePriceId String?
  features      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions PlatformSubscription[]

  @@map("plans")
}

model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_counters")
}

enum UserRole {
  USER
  SUPERADMIN
}

enum InvitationStatus {
  ACCEPTED
  PENDING
  DECLINED
}

enum SubscriptionType {
  FREE
  STANDARD
  PREMIUM
}

enum TeamRole {
  MEMBER
  OWNER
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
}
