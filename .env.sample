# ============================================================
# Vysify CRM — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----- Core ------------------------------------------------
APP_URL=http://localhost:3000
# In production set to your public canonical URL:
# APP_URL=https://app.yourcompany.com

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-your-own-secret
# In production also set NEXTAUTH_URL:
# NEXTAUTH_URL=https://app.yourcompany.com

# Admin seed account
ADMIN_EMAIL=admin@yourcompany.com

# ----- Database --------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
# Optional: Pooler URL (e.g. PgBouncer / Neon / Supabase Pooler)
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLER_HOST:5432/DB?pgbouncer=true

# ----- Branding / Company ----------------------------------
NEXT_PUBLIC_COMPANY_NAME=Vysify CRM
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourcompany.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@yourcompany.com

# ----- Legal / Terms ---------------------------------------
# Increment this date when publishing new Terms of Use.
# Logged-in users will be prompted to re-accept on next visit.
NEXT_PUBLIC_TERMS_VERSION=2026-03-14
TERMS_VERSION=2026-03-14

# ----- Maintenance Mode ------------------------------------
# Set MAINTENANCE_ENABLED=true to show a global maintenance banner.
# MAINTENANCE_ENABLED=false
# MAINTENANCE_MESSAGE=We are performing scheduled maintenance. Back soon!
# MAINTENANCE_EXPECTED_AT=2026-03-15T10:00:00Z

# ----- Payments — Stripe -----------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
PAYMENTS_SECRET_KEY=sk_live_...
PAYMENTS_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_PUBLISHABLE_KEY=pk_live_...
# Stripe Webhook Secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ----- Email -----------------------------------------------
EMAIL_FROM=noreply@yourcompany.com
EMAIL_SERVICE=gmail
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password

# ----- AI (OpenAI) -----------------------------------------
# Required for Pipeline Insights and Conversation Summary features.
OPENAI_API_KEY=sk-...

# ----- AWS S3 (File Uploads) --------------------------------
# Required for attachment uploads in the Inbox and CRM.
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET_NAME=my-crm-bucket

# ----- Vercel API (Custom Domains) -------------------------
NEXT_PUBLIC_VERCEL_IP_ADDRESS=76.76.21.21
VERCEL_API_URL=https://api.vercel.com
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# VERCEL_AUTH_BEARER_TOKEN=

# ----- Web Push (Notifications) ----------------------------
# Generate VAPID keys: npx web-push generate-vapid-keys
# WEB_PUSH_EMAIL=push@yourcompany.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ----- Analytics -------------------------------------------
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ----- Error Tracking (Sentry) -----------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ----- Cron Jobs -------------------------------------------
# Secret token used to authenticate scheduled cron requests.
# CRON_SECRET=replace-with-random-secret

# ----- FinOps (Cost Estimation per Workspace) --------------
# Unit costs used to estimate platform expenses in the FinOps dashboard.
# FINOPS_UNIT_COST_WHATSAPP_OUTBOUND=0.03
# FINOPS_UNIT_COST_AI_REQUEST=0.01
# FINOPS_UNIT_COST_UPLOAD_REQUEST=0.001

# ----- NFS-e (Brazilian Electronic Invoices — Optional) ----
# NFSE_ENABLED=false
# FOCUS_NFE_API_KEY=
# FOCUS_NFE_ENVIRONMENT=homologacao
# FOCUS_NFE_NFSE_ENDPOINT=nfsen
# NFSE_CODIGO_TRIBUTACAO_NACIONAL_ISS=
# NFSE_CODIGO_NBS=